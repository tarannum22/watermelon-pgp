# /etc/watermelonpgp/watermelonpgp.env — settings for `watermelonpgp serve`. Every flag has a
# WATERMELONPGP_* variable; see `watermelonpgp serve --help`.

# Keep the master key outside the data directory, so backups of one never contain the other.
WATERMELONPGP_MASTER_KEY_FILE=/etc/watermelonpgp/key/master.key

# Loopback only by default. To expose the UI, either serve HTTPS directly...
#WATERMELONPGP_BIND=0.0.0.0:8443
#WATERMELONPGP_TLS_CERT=/etc/watermelonpgp/tls/fullchain.pem
#WATERMELONPGP_TLS_KEY=/etc/watermelonpgp/tls/privkey.pem
# ...or keep it on loopback behind an HTTPS reverse proxy and mark cookies Secure:
#WATERMELONPGP_SECURE_COOKIES=true

# json for log collectors; text for reading with journalctl.
WATERMELONPGP_LOG_FORMAT=text
# Log level: error, warn, info, debug.
WATERMELONPGP_LOG=info
