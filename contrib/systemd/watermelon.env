# /etc/watermelon/watermelon.env — settings for `watermelon serve`. Every flag has a
# WATERMELON_* variable; see `watermelon serve --help`.

# Keep the master key outside the data directory, so backups of one never contain the other.
WATERMELON_MASTER_KEY_FILE=/etc/watermelon/key/master.key

# Loopback only by default. To expose the UI, either serve HTTPS directly...
#WATERMELON_BIND=0.0.0.0:8443
#WATERMELON_TLS_CERT=/etc/watermelon/tls/fullchain.pem
#WATERMELON_TLS_KEY=/etc/watermelon/tls/privkey.pem
# ...or keep it on loopback behind an HTTPS reverse proxy and mark cookies Secure:
#WATERMELON_SECURE_COOKIES=true

# json for log collectors; text for reading with journalctl.
WATERMELON_LOG_FORMAT=text
# Log level: error, warn, info, debug.
WATERMELON_LOG=info
