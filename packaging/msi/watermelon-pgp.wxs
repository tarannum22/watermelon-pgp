<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer (WiX v5), built by packaging/msi/build.ps1 from the release zip's files.
  Same layout as the Chocolatey package: C:\Program Files\WatermelonPGP, on the machine Path.
  It doesn't run `init` or `service install` and doesn't touch any data directory.
  Defines: Version (X.Y.Z), Payload (the unpacked zip folder), Generated (actions.wxi's folder).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include $(var.Generated)\actions.wxi ?>
  <!-- WixQuietExec wants the program quoted; the quotes go in each Value (a define can't hold
       them), followed by these arguments and the encoded script. -->
  <?define PowerShellArgs = "-NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand" ?>

  <!-- UpgradeCode: never change it, or a new version installs next to the old one. -->
  <Package Name="WatermelonPGP" Manufacturer="WatermelonPGP" Version="$(var.Version)"
           UpgradeCode="B33BC9D9-6AA6-4E32-8089-DA114EE26D41" Scope="perMachine">
    <!-- The old version is removed first, then the new one installed: no file-version rules. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of WatermelonPGP is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://tarannum22.github.io/watermelon-pgp/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/tarannum22/watermelon-pgp/blob/v$(var.Version)/docs/deployment.md#windows-server" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- A private property (not all uppercase): the folder can't be changed on the msiexec
         command line, as service.ps1 and the documented layout expect it here. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="InstallFolder" Name="WatermelonPGP" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="SystemPath" />
    </Feature>

    <ComponentGroup Id="Payload" Directory="InstallFolder">
      <Files Include="$(var.Payload)\**" />
    </ComponentGroup>

    <Component Id="SystemPath" Directory="InstallFolder">
      <Environment Id="SystemPathEntry" Name="PATH" Value="[InstallFolder]" Part="last" Action="set"
                   System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\WatermelonPGP" Name="InstallDir" Type="string"
                     Value="[InstallFolder]" KeyPath="yes" />
    </Component>

    <!--
      service.ps1, one custom action per step. The checks run before anything changes and fail
      the installation with the reason in the MSI log. Stop runs before the old version is
      removed, start at the end; on a failed installation, the rollback starts them again.
      None of them run while a version is removed (REMOVE="ALL"), which is how an upgrade
      removes the old version too.
    -->
    <SetProperty Action="SetCheckInstallCmd" Id="WixQuietExecCmdLine" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; $(var.PowerShellArgs) $(var.CmdCheckInstall)"
                 Before="WmCheckInstall" Sequence="execute" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="WmCheckInstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="check" />

    <SetProperty Action="SetCheckUninstallCmd" Id="WixQuietExecCmdLine" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; $(var.PowerShellArgs) $(var.CmdCheckUninstall)"
                 Before="WmCheckUninstall" Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="WmCheckUninstall" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="immediate" Return="check" />

    <SetProperty Id="WmRollbackStart" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; $(var.PowerShellArgs) $(var.CmdStart)" Before="WmRollbackStart"
                 Sequence="execute" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="WmRollbackStart" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="rollback" Impersonate="no" Return="ignore" />

    <SetProperty Id="WmStopServices" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; $(var.PowerShellArgs) $(var.CmdStop)" Before="WmStopServices"
                 Sequence="execute" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="WmStopServices" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="WmStartServices" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; $(var.PowerShellArgs) $(var.CmdStart)" Before="WmStartServices"
                 Sequence="execute" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    <CustomAction Id="WmStartServices" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="check" />

    <InstallExecuteSequence>
      <Custom Action="WmCheckInstall" After="InstallValidate" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="WmCheckUninstall" After="WmCheckInstall"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Between InstallInitialize and the old version's removal (MajorUpgrade). -->
      <Custom Action="WmStopServices" Before="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="WmRollbackStart" Before="WmStopServices" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="WmStartServices" Before="InstallFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
