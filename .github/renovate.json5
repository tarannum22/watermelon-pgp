// Renovate: dependency update PRs for Cargo, e2e/ npm, GitHub Actions and the Dockerfile.
// Docs: https://docs.renovatebot.com/configuration-options/
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Once a month: the 1st, 00:00-03:59 UTC. Security fixes are not held to it.
    'schedule:monthly',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  // Match the repo's "Area: subject" commit style: "Deps: update …".
  commitMessagePrefix: 'Deps:',
  commitMessageAction: 'update',
  // Refresh Cargo.lock and e2e/package-lock.json, on the same monthly schedule.
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-3 1 * *'],
  },
  packageRules: [
    // One PR per ecosystem for minor and patch updates. Major updates stay separate PRs.
    // Pre-release crates (lightningcss 1.0.0-alpha.N) can break in any bump: their own PRs.
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['patch'],
      matchCurrentVersion: '!/-/',
      groupName: 'Rust crates (non-breaking)',
      groupSlug: 'rust-crates',
    },
    {
      // In Cargo, 0.x minor bumps (pgp 0.21 -> 0.22, axum 0.8 -> 0.9) are breaking.
      // Keep them out of the group, as their own PRs, like majors.
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '!/^0\\.|-/',
      groupName: 'Rust crates (non-breaking)',
      groupSlug: 'rust-crates',
    },
    {
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'e2e npm packages (non-major)',
      groupSlug: 'e2e-npm',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'GitHub Actions (non-major)',
      groupSlug: 'github-actions',
    },
    {
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      groupName: 'Docker base images (non-major)',
      groupSlug: 'docker-images',
    },
    // dtolnay/rust-toolchain refs are branches, not release tags: "stable" follows the
    // latest Rust and "1.89" is the MSRV job, which must match rust-version in Cargo.toml.
    // Both are changed by hand, so Renovate leaves them alone.
    {
      matchManagers: ['github-actions'],
      matchPackageNames: ['dtolnay/rust-toolchain'],
      enabled: false,
    },

    // Automerge: minor, patch and digest updates merge on their own once CI passes.
    // Renovate merges only when every check on the PR is green; a failing PR stays open.
    // Versions must be 3 days old first, so a broken release has time to be pulled.
    {
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      minimumReleaseAge: '3 days',
      automerge: true,
    },
    // Everything below waits for a manual review and merge.
    // Major updates.
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // Cargo 0.x minor bumps are breaking, so they count as major.
    {
      matchManagers: ['cargo'],
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '/^0\\./',
      automerge: false,
    },
    // Pre-release crates: any bump can break.
    {
      matchManagers: ['cargo'],
      matchCurrentVersion: '/-/',
      automerge: false,
    },
    // CI tests ci.yml changes, but not release.yml (no pull request trigger) or the deploy
    // steps of pages.yml (main only), so action updates there would merge untested.
    {
      matchManagers: ['github-actions'],
      matchFileNames: ['.github/workflows/release.yml', '.github/workflows/pages.yml'],
      automerge: false,
    },
  ],
}
