{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'schedule:weekly',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  commitMessagePrefix: 'Deps:',
  commitMessageAction: 'update',
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      matchCurrentVersion: '!/-/',
      groupName: 'Rust crates (non-breaking)',
      groupSlug: 'rust-crates',
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '!/^0\\.|-/',
      groupName: 'Rust crates (non-breaking)',
      groupSlug: 'rust-crates',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'e2e npm packages (non-major)',
      groupSlug: 'e2e-npm',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'GitHub Actions (non-major)',
      groupSlug: 'github-actions',
    },
    {
      matchManagers: [
        'dockerfile',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Docker base images (non-major)',
      groupSlug: 'docker-images',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'dtolnay/rust-toolchain',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'e2e/package.json',
      ],
      matchDepTypes: [
        'devDependencies',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      minimumReleaseAge: '3 days',
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchFileNames: [
        '.github/workflows/ci.yml',
      ],
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      minimumReleaseAge: '3 days',
      automerge: true,
    },
  ],
}
